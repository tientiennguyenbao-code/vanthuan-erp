{
  "name": "vanthuan-erp",
  "private": true,
  "description": "Phần mềm quản trị vận hành – Công ty TNHH Vạn Thuận Global",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
