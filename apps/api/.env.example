# Chuỗi kết nối cơ sở dữ liệu PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vanthuan_dev
# Khoá bí mật 32 byte (base64) để mã hoá mã xác thực 2 lớp. Tạo bằng: openssl rand -base64 32
APP_KEY=
# Cổng máy chủ
PORT=4000
# Đặt "true" khi chạy thật qua HTTPS
COOKIE_SECURE=false
# Tên hiển thị trong ứng dụng xác thực trên điện thoại
TOTP_ISSUER=Van Thuan Global
